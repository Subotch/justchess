{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": false
  },
  "include": [
    "src/server/**/*.ts",
    "src/db/**/*.ts",
    "src/lib/**/*.ts",
    "src/services/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/lib/i18n/useTranslation.tsx",
    "src/workers/**"
  ]
}
