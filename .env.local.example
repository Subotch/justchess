# Environment variables for local development
# NOT committed to git — use Amvera Cloud variables for production

NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Database (PostgreSQL)
# Get this from your PostgreSQL provider (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/justchess

# Better-Auth
BETTER_AUTH_SECRET=dev-secret-placeholder-min-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (for CORS and Socket.IO)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis (optional — rate limiter works in-memory without it)
# REDIS_URL=redis://localhost:6379
